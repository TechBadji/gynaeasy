# ─── Base de données ─────────────────────────────────────────────────────────
# PostgreSQL (Supabase, Neon, ou local Docker)
DATABASE_URL="postgresql://user:password@host:5432/gynaeasy?sslmode=require"

# ─── Chiffrement AES-256-GCM (données médicales) ─────────────────────────────
# Génère une clé hex 64 caractères :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  L'app crashe au démarrage si cette clé est invalide ou absente.
ENCRYPTION_KEY="remplacer_par_64_caracteres_hex"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="une_chaine_aleatoire_securisee_min_32_chars"

# ─── URL publique de l'application ────────────────────────────────────────────
# Utilisé pour les emails (liens de vérification, reset mot de passe…)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Sur Vercel, cette variable est injectée automatiquement :
# VERCEL_URL="votre-projet.vercel.app"

# ─── Email transactionnel (SMTP) ──────────────────────────────────────────────
# Si absent, les emails sont simulés dans les logs (mode développement)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre@email.com"
SMTP_PASS="mot_de_passe_application"
SMTP_FROM="Gynaeasy <no-reply@gynaeasy.com>"

# ─── Orange Developer API (SMS Sénégal) ──────────────────────────────────────
# Obtenir les credentials sur https://developer.orange.com → Mon App → SMS Messaging
# ⚠️  Credentials sandbox = requêtes acceptées mais SMS non délivrés physiquement.
#     Demander l'accès production pour activer les SMS réels.
ORANGE_SMS_CLIENT_ID=""
ORANGE_SMS_CLIENT_SECRET=""
# Format long number : +221XXXXXXXXX | Format short code : 326742 (sans + ni indicatif)
ORANGE_SMS_SENDER_NUMBER="+221XXXXXXXXX"
# Optionnel — nom affiché si validé par Orange
ORANGE_SMS_SENDER_NAME="Gynaeasy"

# ─── WhatsApp Business API (optionnel) ────────────────────────────────────────
# Laisser vide pour activer le mode simulation (log console uniquement)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ─── Cron jobs (rappels automatiques) ─────────────────────────────────────────
# Clé secrète pour sécuriser l'endpoint /api/reminders/cron
# Exemple cron-job.org : GET https://votre-app.com/api/reminders/cron
#   Header → Authorization: Bearer <CRON_SECRET>
CRON_SECRET="une_chaine_aleatoire_securisee"

# ─── Stripe (paiements abonnements — optionnel) ───────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

